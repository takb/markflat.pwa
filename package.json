{
  "name": "markflat.pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm api && pnpm build && pnpm coverage && pnpm e2e && pnpm audit --prod",
    "api": "composer --working-dir=api check",
    "dev:api": "MARKFLAT_CONFIG=api/dev/config.php php -S 127.0.0.1:8090 api/public/index.php"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lucide/vue": "^1.73.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "15.0.0",
    "markdown-it": "^15.0.3",
    "markdown-it-markflat": "workspace:*",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "sortablejs": "1.15.7",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/sortablejs": "1.15.9",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  }
}
