{
    "name": "takb/markflat-api",
    "description": "markflat's songbook API (backend v2)",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "Markflat\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markflat\\Api\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": ["@cs", "@stan", "@test"]
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    }
}
