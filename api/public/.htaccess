# Apache does not apply the webroot's rewrite rules in this folder, so plain http is redirected
# here too: a key must never travel unencrypted. Then every request goes to index.php; the code
# in lib/ is never served.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteRule ^lib(/|$) - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
